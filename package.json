{
  "name": "abeemap",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "ng": "ng",
    "dev": "ng serve",
    "build": "ng build --configuration production --base-href /abeemap/",
    "unpublish": "ssh -p 21812 user@nano-things.net 'rm -rf apps/html/abeemap'",
    "publish": "scp -r -P 21812 ./dist/abeemap user@nano-things.net:apps/html/abeemap",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "test:coverage": "ng test --watch=false --browsers=ChromeHeadless --code-coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/elements": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@geoman-io/leaflet-geoman-free": "^2.20.2",
    "jsonc-parser": "^3.3.1",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.4.0",
    "leaflet.awesome-markers": "^2.0.5",
    "leaflet.fullscreen": "^5.3.3",
    "mqtt": "^5.16.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@types/google.maps": "^3.66.4",
    "@types/jasmine": "^5.1.15",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.13.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "typescript": "~6.0.3"
  }
}
